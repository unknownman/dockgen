{% set img_version = runtime_version | default(value="3.11") %}
{% if base_image_variant == "alpine" %}
{% set python_base = "python:" ~ img_version ~ "-alpine" %}
{% else %}
{% set python_base = "python:" ~ img_version ~ "-slim" %}
{% endif %}
# === Stage 1: Build dependencies ===
FROM {{ python_base }} AS builder
WORKDIR /app

{% if base_image_variant != "alpine" %}
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev && \
    rm -rf /var/lib/apt/lists/*
{% else %}
RUN apk add --no-cache build-base libpq-dev
{% endif %}

COPY requirements.txt* pyproject.toml* poetry.lock* Pipfile* Pipfile.lock* ./

RUN pip install --no-cache-dir --upgrade pip && \
    if [ -f poetry.lock ]; then \
        pip install --no-cache-dir poetry && \
        poetry config virtualenvs.create false && \
        poetry install --no-dev --no-interaction --no-ansi; \
    elif [ -f Pipfile.lock ]; then \
        pip install --no-cache-dir pipenv && \
        pipenv requirements > requirements.txt && \
        pip install --no-cache-dir -r requirements.txt; \
    elif [ -f requirements.txt ]; then \
        pip install --no-cache-dir -r requirements.txt; \
    fi

# === Stage 2: Production runner ===
FROM {{ python_base }} AS runner
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

{% if base_image_variant != "alpine" %}
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --gid 1001 appgroup && \
    useradd --uid 1001 --gid appgroup --shell /bin/sh --create-home appuser
{% else %}
RUN apk add --no-cache libpq && \
    addgroup -g 1001 appgroup && \
    adduser -u 1001 -G appgroup -s /bin/sh -D appuser
{% endif %}

COPY --from=builder /usr/local/lib/python{{ img_version | split(pat=".") | slice(start=0, end=2) | join(pat=".") }}/site-packages /usr/local/lib/python{{ img_version | split(pat=".") | slice(start=0, end=2) | join(pat=".") }}/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY . .

USER appuser
EXPOSE {{ port | default(value=8000) }}

{% if start_command -%}
CMD ["sh", "-c", "{{ start_command }}"]
{% else -%}
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "{{ port | default(value=8000) }}"]
{% endif -%}
