# === Stage 1: Build the binary ===
FROM golang:{{ runtime_version | default(value="1.22") }}-alpine AS builder
WORKDIR /app

RUN apk add --no-cache ca-certificates

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /app/server ./cmd/server 2>/dev/null || \
    CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /app/server .

# === Stage 2: Minimal runtime ===
FROM alpine:3.19 AS runner
RUN apk add --no-cache ca-certificates && \
    addgroup -g 1001 appgroup && \
    adduser -u 1001 -G appgroup -s /bin/sh -D appuser

WORKDIR /app
COPY --from=builder --chown=appuser:appgroup /app/server .

USER appuser
EXPOSE {{ port | default(value=8080) }}

CMD ["./server"]
